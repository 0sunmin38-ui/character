  "patterns": [
    {
      "key": "gemini",
      "re": "젬\\s?(이오|삼칠플|삼칠|삼일|삼|\\d+(\\.\\d+)?)",
      "type": "model",
      "canon": "Gemini",
      "gloss": "젬 + 숫자 읽기 = Gemini 버전 (젬이오=2.5, 젬삼일=3.1, 젬삼칠플=3.7 Flash)"
    },
    {
      "key": "opus",
      "re": "(\\d{1,2})?푸스",
      "type": "model",
      "canon": "Claude Opus",
      "gloss": "숫자 + 푸스 = Opus 버전 (5푸스=Opus 5, 47푸스=Opus 4.7)"
    },
    {
      "key": "sonnet",
      "re": "소넷\\s?\\d+(\\.\\d+)?",
      "type": "model",
      "canon": "Claude Sonnet",
      "gloss": "소넷 + 버전"
    },
    {
      "key": "nai",
      "re": "(nai|노벨\\s?ai)\\s?v?\\d(\\.\\d)?",
      "type": "model",
      "canon": "NovelAI",
      "gloss": "이미지 생성 모델 버전 표기"
    },
    {
      "key": "platmodel",
      "re": "(롶|케|팊|팟|움)(푸스|삼칠플|삼칠|이오|넷)",
      "type": "model",
      "canon": "플랫폼 + 모델 합성어",
      "gloss": "플랫폼 약칭 뒤에 모델 약칭을 붙여 부르는 말이에요. 롶푸스는 로판AI의 Opus, 케푸스는 케덕의 Opus"
    }
  ],
